# Infraestructura (Docker Compose). Copia este archivo como .env en la raíz del proyecto, en el servidor.
# Contraseñas: SOLO letras y números (van dentro de URLs). Genera cada una con:
#   python3 -c "import secrets; print(secrets.token_hex(24))"

# Dominio público (sin https://), p. ej. centinela.me o centinela.duckdns.org
CENTINELA_DOMINIO=
# Correo para los avisos de Let's Encrypt sobre el certificado HTTPS
CENTINELA_CORREO_TLS=

# PostgreSQL: superusuario (solo para crear la base) y los dos roles de Centinela
POSTGRES_PASSWORD=
CENTINELA_CLAVE_OWNER=
CENTINELA_CLAVE_APP=

# Respaldos: clave con la que se cifran (guárdala FUERA del servidor: sin ella no se pueden restaurar)
CENTINELA_CLAVE_RESPALDOS=
CENTINELA_DIAS_RESPALDO=14

# Copia de respaldos en Azure Blob Storage (opcional, perfil «nube»): URL SAS del contenedor con permiso de escritura
CENTINELA_BLOB_SAS_URL=
CENTINELA_CONTENEDOR_BLOB=respaldos
