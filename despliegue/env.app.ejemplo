# Aplicación. Copia este archivo como .env.app en la raíz del proyecto, en el servidor (permisos 600).
# Las URL de la base de datos, el dominio y el modo producción los pone docker-compose.prod.yml a partir de .env.

# Secretos (obligatorios). Generarlos EN el servidor:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CENTINELA_JWT_SECRETO=
#   docker compose -f docker-compose.prod.yml run --rm --no-deps api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CENTINELA_LLAVE_CIFRADO=

# Responsable del tratamiento de datos (aparece en la Política de privacidad: Ley 1581)
CENTINELA_RESPONSABLE_NOMBRE=
CENTINELA_RESPONSABLE_CORREO=

# Gmail (Google Cloud → Credenciales → ID de cliente OAuth, tipo «Aplicación web»)
CENTINELA_GMAIL_CLIENT_ID=
CENTINELA_GMAIL_CLIENT_SECRET=

# Notificaciones push: docker compose -f docker-compose.prod.yml run --rm --no-deps api centinela generar-vapid --contacto mailto:tu@correo
CENTINELA_VAPID_CLAVE_PRIVADA=
CENTINELA_VAPID_CONTACTO=

# Asistente de IA (opcional): https://aistudio.google.com/apikey
CENTINELA_GEMINI_CLAVE=

# Gmail en tiempo real (opcional): docs/guia_tiempo_real_gmail.md
CENTINELA_PUBSUB_TEMA=
CENTINELA_PUBSUB_AUDIENCIA=
CENTINELA_PUBSUB_CUENTA_SERVICIO=
